  ],
  "checks": [
    {
      "type": "answer_matches",
      "name": "right-value",
      "pattern": "0\\.15\\b|\\b15\\s*%"
    },
    {
      "type": "answer_cites",
      "name": "cites-rates",
      "file": "src/rates.js"
    },
    {
      "type": "answer_cites",
      "name": "cites-pricing",
      "file": "src/pricing.js"
    },
    {
      "type": "tree_clean",
      "name": "read-only"
    }
  ],
  "expect": {
    "gate": "done"
  }
}
