{
  "id": "ask-multihop",
  "family": "ask",
  "split": "dev",
  "title": "answer needs two files combined (tax minus member discount)",
  "steps": [
    {
      "role": "ask",
      "target": "src",
      "instruction": "What effective tax rate applies to an order shipped to the EU region when the customer is a member, and which files and lines determine it?"
