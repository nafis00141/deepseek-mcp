# Only needed for local testing (node src/server.ts).
# Claude Desktop passes these in the "env" block of its MCP config instead.

REPO_ROOT=C:\path\to\your\project
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# Git path. Leave unset to auto-discover (PATH, then SourceTree's bundled copy,
# then the usual install locations).
# GIT_BIN=C:\Users\you\AppData\Local\Atlassian\SourceTree\git_local\cmd\git.exe

# Optional
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# MAX_TURNS=30
# TIMEOUT_MS=900000
# REQUEST_TIMEOUT_MS=300000
# DIFF_CAP=600
# DEEPSEEK_THINKING=enabled # enabled (default) | disabled: DeepSeek thinking mode
# DEEPSEEK_EFFORT=high      # low | high (default) | max: reasoning effort, used only while thinking is enabled
# TEMPERATURE=0.2          # used only when thinking is disabled
# MAX_TOKENS=32000         # default 32000 with thinking (reasoning tokens count), 8000 without
# BASE_REF=main            # pin the branch reviews diff against (default: main, then master)
# MAX_WAIT_S=45            # longest a tool call blocks before returning a job_id
# MAX_FIX_ROUNDS=2         # fix rounds per task before the server says 'escalate'
# MAX_REPAIRS=2            # in-job repair attempts when the self-check (tests / summary block) fails
# CONTEXT_CHARS=6000       # size of the context pack added to each prompt; 0 turns it off

